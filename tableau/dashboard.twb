    <worksheet name='Price paid vs. what we&apos;d bid'>
      <table>
        <view>
          <datasources>
            <datasource caption='policy_backtest' name='federated.0h027ym0dd12lc1gz2ivj1d2roro' />
          </datasources>
          <datasource-dependencies datasource='federated.0h027ym0dd12lc1gz2ivj1d2roro'>
            <column caption='Pass Reason' datatype='string' name='[Calculation_1777691216949255]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [keep] THEN &quot;Bought&quot;&#13;&#10;                      ELSEIF [IsBadBuy] = 1 THEN &quot;Passed: kick avoided&quot;&#13;&#10;                      ELSEIF [profit_if_bought] &lt; 0 THEN &quot;Passed: good car, but overpriced&quot;&#13;&#10;                      ELSE &quot;Passed: profitable car given up&quot; END' />
            </column>
            <column caption='Diagonal' datatype='real' name='[Calculation_1777691233148943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[max_bid]' />
            </column>
            <column caption='Is Bad Buy' datatype='integer' name='[IsBadBuy]' role='measure' type='quantitative' />
            <column caption='Veh B Cost' datatype='real' name='[VehBCost]' role='measure' type='quantitative' />
            <column caption='Keep' datatype='boolean' name='[keep]' role='dimension' type='nominal' />
            <column caption='Max Bid' datatype='real' name='[max_bid]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1777691216949255]' derivation='None' name='[none:Calculation_1777691216949255:nk]' pivot='key' type='nominal' />
            <column caption='Profit If Bought' datatype='real' name='[profit_if_bought]' role='measure' type='quantitative' />
