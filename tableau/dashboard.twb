      <aliases enabled='yes' />
      <column caption='Byrno' datatype='integer' name='[BYRNO]' role='measure' type='quantitative' />
      <column caption='Decision' datatype='string' name='[Calculation_1777691216244736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [keep] THEN &quot;Buy&quot; ELSE &quot;Pass&quot; END' />
      </column>
      <column caption='Outcome' datatype='string' name='[Calculation_1777691216543745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsBadBuy] = 1 THEN &quot;Kicked&quot; ELSE &quot;Good&quot; END' />
      </column>
      <column caption='Historical Profit' datatype='real' name='[Calculation_1777691216642050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[profit_if_bought]' />
      </column>
      <column caption='Policy Profit' datatype='real' name='[Calculation_1777691216769027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [keep] THEN [profit_if_bought] ELSE 0 END' />
      </column>
      <column caption='Saving' datatype='real' name='[Calculation_1777691216797700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1777691216769027]) - SUM([Calculation_1777691216642050])' />
      </column>
      <column caption='Kicks Avoided' datatype='integer' name='[Calculation_1777691216838661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT [keep] AND [IsBadBuy] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Paid Over Max Bid' datatype='real' name='[Calculation_1777691216891910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[VehBCost] - [max_bid]' />
      </column>
      <column caption='Pass Reason' datatype='string' name='[Calculation_1777691216949255]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [keep] THEN &quot;Bought&quot;&#13;&#10;                      ELSEIF [IsBadBuy] = 1 THEN &quot;Passed: kick avoided&quot;&#13;&#10;                      ELSEIF [profit_if_bought] &lt; 0 THEN &quot;Passed: good car, but overpriced&quot;&#13;&#10;                      ELSE &quot;Passed: profitable car given up&quot; END' />
      </column>
      <column caption='Impact' datatype='real' name='[Calculation_1777691217203208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([Calculation_1777691216642050])' />
      </column>
      <column caption='Impact Sign' datatype='string' name='[Calculation_1777691217235977]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1777691217203208] &gt; 0 THEN &quot;Gain&quot; ELSE &quot;Cost&quot; END' />
      </column>
      <column caption='Diagonal' datatype='real' name='[Calculation_1777691233148943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[max_bid]' />
      </column>
      <column caption='Is Bad Buy' datatype='integer' name='[IsBadBuy]' role='measure' type='quantitative' />
